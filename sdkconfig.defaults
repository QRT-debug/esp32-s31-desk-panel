CONFIG_IDF_TARGET="esp32s31"

# ---- Flash / 分区表 ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16MiB.csv"
# ★ 启用 esptool stub loader：在芯片 RAM 里跑，块更大、往返更少，
#   比 ROM loader 快 2~3 倍。关掉它（NO_STUB=y）会让 1.4 MB 固件烧 30 秒以上。
# CONFIG_ESPTOOLPY_NO_STUB is not set

# ---- PSRAM（RGB 屏双帧缓冲必需，每块 768 KB）----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- 系统 ----
# 1000Hz tick：vTaskDelay(1) 才是 1ms，否则等 vsync 会多等 10ms，实测帧率掉 1/3
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# ★ 主任务栈必须加大：LVGL 在 app_main 上下文渲染 800x480，
#   默认 3584 B 会在第 3~4 帧就 Stack protection fault（表现为"进 LVGL 就重启"）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576


# ---- LVGL 9.6 ----
# 16 位色深：与 RGB565 面板一致，避免每次 flush 做格式转换
CONFIG_LV_COLOR_DEPTH_16=y
# 用标准 malloc 而不是内置 TLSF 池：benchmark 会创建大量对象，
# IDF 的 SPIRAM_USE_MALLOC 会让大块自动落到 PSRAM，不受固定池大小限制
CONFIG_LV_USE_CLIB_MALLOC=y
# 官方 benchmark：给出各类控件的标准渲染耗时，作为 V3 选型依据
CONFIG_LV_USE_DEMO_BENCHMARK=y
# 把 benchmark 的每个场景结果打到串口（LV_LOG_USER 就是它用的级别）
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_USER=y
CONFIG_LV_LOG_PRINTF=y
# 性能数据只打日志，不占屏幕（之前右下角一直显示 "6 FPS, 35% CPU"）
CONFIG_LV_USE_PERF_MONITOR_LOG_MODE=y
# 16ms 刷新周期，对齐 60fps
CONFIG_LV_DEF_REFR_PERIOD=16
# 监控界面用到的字号
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# ---- 11-20 天气页 + PPA 硬件渲染（★ 两行必须成对，见 MEMORY 铁律）----
CONFIG_LV_USE_PPA=y
CONFIG_LV_DRAW_BUF_ALIGN=64
# 关掉 LVGL 示例（编译了但不链接，省编译时间）
# CONFIG_LV_BUILD_EXAMPLES is not set
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y

# ---- 11-21 mbedTLS 大块缓冲放 PSRAM（否则 B 站等长证书链站点握手 -0x3000 内存不足）----
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384

# ★★★ 11-22 删掉 11-21 留下的 CONFIG_SPIRAM_SPEED_200M=y —— 它和上面的 250M 同时 =y，
#    是**非法配置**，而 IDF 以已存在的 sdkconfig 为准 ⇒ 那次"降到 200M"的对照实验
#    **从未生效**（build 时一直是 250M），所以"PSRAM 200M 仍闪 ⇒ 与 PSRAM 无关"这个结论是假的。
#    真正的闪因已定位：LVGL 双缓冲 refr_sync_areas 的 memcpy 没做 cache 写回（见 lvgl_port.c）。
#    PSRAM 保持 250M（性能最好）。若将来要重做 200M 对照，必须同时改 sdkconfig 而不是只改这里。
